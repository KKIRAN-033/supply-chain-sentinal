# ==============================================================================
# Supply-Chain Sentinel — Git Ignore Rules
# ==============================================================================

# Environment & Secrets (Never commit production credentials or API keys)
.env
.env.production
.env.local
.env.*.local
*.env
!/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/
*.egg-info/
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
*.manifest
*.spec

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases & Runtime Storage
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
!backend/data/sentinel.db
backend/data/artifacts/*
!backend/data/artifacts/.gitkeep
backend/data/json_fallback/*
!backend/data/json_fallback/.gitkeep

# IDEs & OS Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Agent & Workspace Cache
.agent/
.agents/
.gemini/
.gsd/
.kilo/
scratch/
