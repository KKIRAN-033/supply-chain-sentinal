# ==============================================================================
# Supply-Chain Sentinel — Production Environment Variables
# Prefix: SCS_
# ==============================================================================

# Application Runtime
SCS_APP_NAME="Supply-Chain Sentinel"
SCS_APP_VERSION=1.0.0
SCS_ENVIRONMENT=production
SCS_DEBUG=False
SCS_LOG_LEVEL=INFO
SCS_WORKERS=4

# Networking & Security
SCS_CORS_ORIGINS=["https://sentinel.yourdomain.com", "http://localhost:8080"]
SCS_SECRET_KEY="generate-a-strong-random-32-byte-hex-string-for-production"
SCS_API_KEY=""
SCS_WEBHOOK_SECRET=""
SCS_STRICT_TRANSPORT_SECURITY=True
SCS_HSTS_MAX_AGE=31536000

# Rate Limiting
SCS_ENABLE_RATE_LIMITING=True
SCS_RATE_LIMIT_PER_MINUTE=180
SCS_SCAN_RATE_LIMIT_PER_MINUTE=25

# Database (SQLite with WAL mode by default, or PostgreSQL)
SCS_DATABASE_URL="sqlite:////app/data/sentinel.db"
# Example PostgreSQL:
# SCS_DATABASE_URL="postgresql://sentinel_user:secret_password@postgres:5432/sentinel_db"

# Storage
SCS_MAX_UPLOAD_SIZE_MB=50

# Upstream Threat Intelligence
SCS_ENABLE_OSV=True
SCS_OSV_TIMEOUT_SECONDS=2.0

# AI Security Analyst (Optional LLM Integration)
SCS_DEEPSEEK_API_KEY=""
SCS_DEEPSEEK_MODEL="deepseek-v4.1-flash"
